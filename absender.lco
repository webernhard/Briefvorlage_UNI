% Logo
% \setkomavar{fromlogo}{\includegraphics{logo.png}}
% --------------------------------------------------  
% HEADER: Logos upper right
% --------------------------------------------------  
\setkomavar{firsthead}{%  
  \raggedleft  
  %\includegraphics[height=2.5cm]{logos/Logo Uni Graz 4c.pdf}\hspace{0.5cm}% 
  %\includegraphics[height=2.5cm]{logos/Logo Uni Graz Claim Kurz 4c.pdf}\hspace{0.5cm}% 
  \includegraphics[height=2.5cm]{logos/Institut für Psychologie.pdf}\hspace{0.5cm}%  
  }

% --------------------------------------------------  
% ORT + DATUM rechts  
% --------------------------------------------------  
\setkomavar{place}{Graz}  
\setkomavar{date}{\today}   % or specified: {April 28 2026}

% Die Bankverbindung wird nicht automatisch verwendet. Dazu muss bspw. mittels \firstfoot ein eigener Brieffuß definiert werden.
\setkomavar{frombank}{}

% ===== Signatur =====
\setkomavar{signature}{%
% Unterschrift (optional als Grafik einfügen)  
%\includegraphics[height=2cm]{unterschrift}\\[1ex]  
  \usekomavar{fromname}%
}
\renewcommand*{\raggedsignature}{\raggedright}

% --------------------------------------------------  
% FUẞZEILE  
% --------------------------------------------------  
\providecommand{\lang}{de}% default: German
\newcommand{\usefromuni}{%
  \ifdefstring{\lang}{en}%
    {\usekomavar{fromunien}}%
    {\usekomavar{fromuni}}%
}%
\newcommand{\usefromunit}{%
  \ifdefstring{\lang}{en}%
    {\usekomavar{fromuniten}}%
    {\usekomavar{fromunit}}%
}%
\newcommand{\usefromaddress}{%
  \ifdefstring{\lang}{en}%
    {\usekomavar{fromaddressen}}%
    {\usekomavar{fromaddress}}%
}%
\newcommand{\usepage}{%
  \ifdefstring{\lang}{en}%
    {\thepage{}/\pageref{LastPage}}%
    {Seite \thepage{} von \pageref{LastPage}}%
}%

\setkomavar{firstfoot}{%
  \parbox{\useplength{firstfootwidth}}{\footnotesize
    \raggedleft
    \textbf{\usefromuni}\\
    \makebox[\linewidth][l]{%
    % ===== Partner Logos =====
      \smash{%
        \includegraphics[height=1.5cm]{logos/logo-med-uni-graz.png}%
        \hspace{3mm}%
        \includegraphics[height=1.5cm]{logos/TU-Graz.png}%
      }%
      \hfill
      \textbf{\usefromunit}%
    }\\
    \usekomavar{fromname}\\
    \usefromaddress\\
    \usekomavar{fromphone} | \usekomavar{fromemail}\\
    \makebox[\linewidth][l]{%
      \usepage
      \hfill
      \usekomavar{fromurl}%
    }%
  }%
} 

