\ProvidesFile{absender.lco}

\KOMAoptions{%
 fromemail=false,       % Email wird im Briefkopf angezeigt
 fromphone=false,       % Telefonnumer wird im Briefkopf angezeigt
% fromfax=true,         % Faxnummer wird im Briefkopf angezeit
 fromurl=false,         % URL wird im Briefkopf angezeigt
% fromlogo=true,        % Logo wird im Briefkopf angezeigt
% subject=titled,       % Druckt "Betrifft: " vor dem Betreff
%locfield=wide,          % Breite Absenderergänzung (location)
%fromalign=left,         % Ausrichtung des Briefkopfes
%fromrule=off, %  % Trennlinie unter dem Briefkopf: afteraddress
 backaddress=off
}
\RequirePackage[utf8]{inputenc}
%\RequirePackage[ngerman]{babel}
\RequirePackage{lastpage}
\RequirePackage{etoolbox}  

\newkomavar{fromunit}%
\newkomavar{fromuniten}%
\newkomavar{fromuni}%
\newkomavar{fromunien}%
\newkomavar{fromaddressen}%
\setkomavar{backaddress}{}%                % no 'return to' in that window 

\setkomavar{fromname}{Maria Musterfrau} % Name
\setkomavar{fromaddress}{Adresse, 8010 Graz, Österreich}
\setkomavar{fromaddressen}{Address, 8010 Graz, Austria}
\setkomavar{fromemail}{vorname.nachname@uni-graz.at} % Email-Adresse
\setkomavar{fromphone}{+43 (0) 316/380-0000} % Telefonnummer
\setkomavar{fromurl}[Website:~]{https://abteilung.uni-graz.at} % Website
\setkomavar{fromunit}{Organisationseinheit | Fachbereich}
\setkomavar{fromuniten}{Department | Section}
%\setkomavar{fromfax}{01234~56789} % Faxnummer
\setkomavar{subjectseparator}{}   % kein „Betreff:“ davor  
\setkomavar{fromuni}{Universität Graz}
\setkomavar{fromunien}{University of Graz}

% ===== Absenderergänzung =====
